module "vpc_dev" {
  source = "./vpc"
  env_name = var.env_name
  #zone     = var.default_zone
  #cidr     = var.vpc_cidr

  #subnets = [
  #  {
  #    zone = var.default_zone,
  #    cidr = var.vpc_cidr
  #  }
  #]
  subnets = [
    { zone = "ru-central1-a", cidr = "10.0.1.0/24" },
    { zone = "ru-central1-b", cidr = "10.0.2.0/24" }
  ]
}

module "vpc_prod" {
  source   = "./vpc"
  env_name = "production"
  subnets = [
    { zone = "ru-central1-a", cidr = "10.0.1.0/24" },
    { zone = "ru-central1-b", cidr = "10.0.2.0/24" },
    #{ zone = "ru-central1-c", cidr = "10.0.3.0/24" },
  ]
}


### Cloud init template
data "template_file" "cloudinit" {
   template = file("./cloud-init.yml")
   vars = {
    #ssh_keys = "- ${file(var.vms_ssh_root_key)}"
     ssh_keys = "\n      - ${file(var.vms_ssh_root_key)}"
   }
}

### marketing module
module "marketing_vm" {
  source      = "git::https://github.com/udjin10/yandex_compute_instance.git?ref=main"
  env_name    = "develop"
  #network_id  = yandex_vpc_network.develop.id
  #network_id = module.vpc_dev.subnet.network_id
  network_id = module.vpc_dev.network_id
  #subnet_zones  = ["ru-central1-a"]
  #subnet_ids    = [yandex_vpc_subnet.develop_a.id]
  #subnet_ids = [module.vpc_dev.subnet.id]
  subnet_ids = [module.vpc_dev.subnet_ids[var.vpc_cidr]]
  subnet_zones = [var.default_zone]
  instance_name = "marketing-server"
  instance_count = 1
  image_family  = "ubuntu-2004-lts"
  public_ip     = true

  labels = {
    owner = var.vm_owner,
    project = var.marketing_project_name
  }

  metadata = {
    user-data = data.template_file.cloudinit.rendered
    serial-port-enable = 1
  }
}

module "mysql_cluster" {
  source = "./mysql_cluster"
  cluster_name = "${var.env_name}-mysql-cluster"
  network_id = module.vpc_dev.network_id
  #subnet_id = module.vpc_dev.subnet_ids[var.vpc_cidr]
  ha = true

  #subnets = {
  #  "ru-central1-a" = module.vpc_dev.subnet_ids[var.vpc_cidr]
  #  "ru-central1-b" = module.vpc_dev.subnet_ids[var.vpc_cidr]
  #}

  subnet_a_id  = module.vpc_dev.subnet_ids["10.0.1.0/24"]
  subnet_b_id  = module.vpc_dev.subnet_ids["10.0.2.0/24"]
}

